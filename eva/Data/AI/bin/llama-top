SIBLING = "llama-mon"       # the other tool that carries the same shared block


def _shared_block(path):
    try:
        src = open(path, "r", errors="replace").read()
    except OSError:
        return None
    m = re.search(r"^# ==== BEGIN shared log-grammar block.*?^# ==== END shared"
                  r" log-grammar block\s*$", src, re.S | re.M)
    return m.group(0) if m else None


def self_test():
    ok = True
    stt = State(DEFAULT_CTX_MAX)
    parsed = 0
    for ln in SAMPLES:
        ev = parse_line(ln)
        assert ev is not None, ln
        if ev["kind"] != "other":
            parsed += 1
        apply_event(stt, ev)
    print("recognized %d/%d lines" % (parsed, len(SAMPLES)))
    assert parsed == len(SAMPLES), "some fixture lines fell through to 'other'"

    assert stt.model.startswith("Ornith-1.5"), stt.model
    assert "mmproj" not in stt.model, stt.model  # main model, not the projector
    assert stt.n_slots == 4, stt.n_slots
    assert stt.n_ctx == 131072, stt.n_ctx        # last new_slot line wins
    assert stt.s_turns == 3, stt.s_turns
    assert stt.s_evict == 1, stt.s_evict
    assert stt.s_errors == 2, stt.s_errors       # metal failure + OOM

    # slot 0's turn: real numbers land in the histories
    t0 = [t for t in stt.turns if t["task"] == 613580][0]
    assert t0["slot"] == 0 and t0["ctx"] == 28029, t0
    assert t0["pp_ok"] and t0["tg_ok"], t0
    # prompt_total 28029-421 = 27608; reuse 27608-3394 = 24214 -> 88%
    assert abs(t0["hit"] - 24214 / 27608.0) < 1e-9, t0["hit"]
    # slot 1's degenerate turn is recorded but excluded from rate histories
    t1 = [t for t in stt.turns if t["task"] == 613999][0]
    assert t1["slot"] == 1 and not t1["pp_ok"] and not t1["tg_ok"], t1
    assert t1["evicted"] == 1, t1
    # slot 1's degenerate rates are excluded; the other two are kept
    assert list(stt.pp_hist) == [553.37, 917.667], list(stt.pp_hist)
    assert list(stt.tg_hist) == [42.99, 50.50], list(stt.tg_hist)
    assert list(stt.ctx_hist) == [28029, 4096, 9167], list(stt.ctx_hist)
    assert stt.s_prefill == 3394 + 2 + 8259, stt.s_prefill
    assert stt.s_gen == 421 + 1 + 909, stt.s_gen
    # the off-by-one turn: 9167 - 909 = 8258, one BELOW its 8259 prefill tokens
    t2 = [t for t in stt.turns if t["task"] == 614100][0]
    assert t2["hit"] == 0.0, t2["hit"]          # clamped, never negative
    # slot 0 reused 24214, slot 1 reused 4093, slot 2's off-by-one contributes
    # 0 — not -1, which is what an unclamped subtraction would have added
    assert stt.s_reuse == 24214 + 4093 + 0, stt.s_reuse
    print("per-slot accounting (3 slots, degenerate + off-by-one turns): ok")

    # concurrency: while slot 0 generates, slot 1 must show as prefilling and
    # neither may overwrite the other. Replay only up to slot 1's first prefill.
    stt2 = State(DEFAULT_CTX_MAX)
    for ln in SAMPLES[:SAMPLES.index(
            "10768.54.000.000 I slot print_timing: id  1 | task 613999 | prompt "
            "processing, n_tokens =   2048, progress = 0.50, t =   2.00 s / "
            "1024.00 tokens per second") + 1]:
        ev = parse_line(ln)
        if ev:
            apply_event(stt2, ev)
    assert set(stt2.slots) == {0, 1}, stt2.slots
    assert stt2.slots[0]["phase"] == "GENERATING", stt2.slots[0]
    assert stt2.slots[0]["task"] == 613580 and stt2.slots[0]["live_gen_n"] == 131
    assert stt2.slots[1]["phase"] == "PREFILL", stt2.slots[1]
    # progress 0.50 is over the WHOLE prompt (cached prefix included), and
    # an LRU pick gives no cache estimate, so the size is honestly unknown
    assert stt2.slots[1]["task"] == 613999 and stt2.slots[1]["live_pp_total"] is None
    assert stt2.slots[1]["live_pp_eta"] is None and stt2.slots[1]["live_pp_frac"] == 0.5
    assert stt2.status() == "GENERATING", stt2.status()
    print("two slots in flight stay independent: ok")

    # Prefill size from the cache estimate. Real numbers (task 43010): slot
    # held 60223, f_keep 0.929, true cached prefix 55950, true new tokens 588.
    st4 = State(DEFAULT_CTX_MAX)
    st4.slot_ctx[0] = 60223
    for ln in (
        "823.09.818.733 I slot get_availabl: id  0 | task -1 | selected slot by LCP similarity, f_sim_best = 0.990 (> 0.100 thold), f_keep = 0.929",
        "823.09.819.370 I slot launch_slot_: id  0 | task 43010 | processing task, is_child = 0",
        "823.12.000.000 I slot print_timing: id  0 | task 43010 | prompt processing, n_tokens =    300, progress = 0.99, t =   2.86 s / 104.90 tokens per second",
    ):
        apply_event(st4, parse_line(ln))
    s4 = st4.slots[0]
    assert s4["cache_est"] == 55947, s4["cache_est"]
    assert abs(s4["live_pp_total"] - 588) < 0.02 * 56538, s4["live_pp_total"]
    # the old n/progress reading would have said ~303 total and ETA ~0s
    assert s4["live_pp_eta"] > 1.0, s4["live_pp_eta"]
    # a slot-state restore invalidates the estimate for the next turn
    apply_event(st4, parse_line("835.43.842.282 I slot load_slot_ch: id  0 | task -1 | restored 4 context checkpoint(s) from '/x.bin'"))
    st4.slot_ctx[1] = 5
    assert 0 not in st4.slot_ctx and 1 in st4.slot_ctx, st4.slot_ctx

    # Without an estimate: extrapolate from two lines. 50k cached + 10k new.
    st5 = State(DEFAULT_CTX_MAX)
    for ln in (
        "1.00.000.000 I slot launch_slot_: id  0 | task 7 | processing task, is_child = 0",
        "1.10.000.000 I slot print_timing: id  0 | task 7 | prompt processing, n_tokens =   1000, progress = 0.85, t =   9.00 s / 111.00 tokens per second",
    ):
        apply_event(st5, parse_line(ln))
    assert st5.slots[0]["live_pp_total"] is None    # one line: unknown, not 85%
    apply_event(st5, parse_line("1.50.000.000 I slot print_timing: id  0 | task 7 | prompt processing, n_tokens =   5200, progress = 0.92, t =  47.00 s / 111.00 tokens per second"))
    assert abs(st5.slots[0]["live_pp_total"] - 10000) < 400, st5.slots[0]["live_pp_total"]
    assert abs(st5.slots[0]["live_pp_eta"] - 4800 / 111.0) < 5, st5.slots[0]["live_pp_eta"]
    print("prefill size/ETA from whole-prompt progress: ok")

    # /slots, when fresh, decides what is busy and supplies the exact cached
    # prefix. Numbers from a live probe on this build (task 44973, cold 8890-
    # token prompt): n_prompt_tokens grows per 2048 chunk and is NOT the
    # prompt size -- reading it as one called the turn done after chunk 1.
    st6 = State(DEFAULT_CTX_MAX)
    st6.phase = "READY"
    apply_event(st6, parse_line("1.00.000.000 I slot launch_slot_: id  3 | task 9 | processing task, is_child = 0"))
    for ln in (
        "860.07.027.890 I slot launch_slot_: id  0 | task 44973 | processing task, is_child = 0",
        "860.17.795.403 I slot print_timing: id  0 | task 44973 | prompt processing, n_tokens =   2048, progress = 0.23, t =   5.38 s / 380.84 tokens per second",
    ):
        apply_event(st6, parse_line(ln))
    st6.live = {0: dict(proc=True, task=44973, P=4096, C=0, done=2048, dec=0, tg=None)}
    st6.live_ok, st6.live_ts = True, time.time()
    b = st6.busy_slots()
    assert set(b) == {0}, b                       # slot 3 not processing -> gone
    assert b[0]["phase"] == "PREFILL", b[0]        # NOT done after chunk 1
    assert abs(b[0]["live_pp_total"] - 8890) < 0.03 * 8890, b[0]["live_pp_total"]
    assert b[0]["live_ctx"] == 4096, b[0]["live_ctx"]
    # warm follow-up (task 45214): exact cache from /slots, 12 new tokens
    st6.live = {0: dict(proc=True, task=45214, P=8910, C=8886, done=12, dec=9, tg=28.0)}
    b = st6.busy_slots()
    assert b[0]["phase"] == "GENERATING" and b[0]["live_ctx"] == 8910, b[0]
    assert st6.status() == "GENERATING"
    st6.live_ts -= LIVE_FRESH + 1                 # stale sample -> log view
    assert set(st6.busy_slots()) == {0, 3}
    assert _parse_slots([{"id": 0, "is_processing": True, "id_task": 5,
                          "n_prompt_tokens": 10, "n_prompt_tokens_cache": 4,
                          "n_prompt_tokens_processed": 3,
                          "next_token": [{"n_decoded": 2}]}])[0] == dict(
        proc=True, task=5, P=10, C=4, done=3, dec=2)
    print("/slots overrides log when fresh, yields when stale: ok")

    # averages are token-weighted: 10 tok in 1s must not equal 10k tok in 10s
    apv, _ = recent_averages([
        dict(pp_stat=True, pp_tok=10000, pp_ms=10000.0, tg_ok=False),
        dict(pp_stat=True, pp_tok=100, pp_ms=1000.0, tg_ok=False)])
    assert abs(apv - 10100 / 11.0) < 1e-6, apv
    print("token-weighted averages: ok")

    # A slot cut off mid-turn (log rotated, server killed) never gets its
    # release line and must stop being reported as busy.
    stt3 = State(DEFAULT_CTX_MAX)
    for ln in SAMPLES:
        ev = parse_line(ln)
        if ev and ev["kind"] != "release":         # every turn left in flight
            apply_event(stt3, ev)
    assert set(stt3.slots) == {0, 1, 2}, stt3.slots
    assert stt3.status() != "IDLE", stt3.status()
    for sl in stt3.slots.values():                 # age them past the cutoff
        sl["last_seen"] -= STALE_SLOT_SECS + 1
    assert stt3.status() == "IDLE", stt3.status()
    assert stt3.slots == {}, stt3.slots
    print("stale slots stop being reported as busy: ok")

    rows, mx = graph_rows([10, 20, 40], width=3, height=2, floor=1.0)
    assert len(rows) == 2 and all(len(r) == 3 for r in rows), rows
    assert mx == 40
    # The zone label must agree with the fullness gauge printed beside it.
    # 27.9k of a 262k window is 11% full and must never read as "long".
    assert ctx_zone(27900, 262144) == "short", ctx_zone(27900, 262144)
    assert ctx_zone(8000, 32768) == "medium", ctx_zone(8000, 32768)
    assert ctx_zone(28029, 65536) == "long", ctx_zone(28029, 65536)
    assert ctx_zone(28029, 40000) == "very-long", ctx_zone(28029, 40000)
    assert ctx_zone(28029, 32768) == "extreme", ctx_zone(28029, 32768)
    assert ctx_zone(1000, 0) == "short"                  # no window known yet
    # the recorded turn used the real window, so it is nowhere near full
    assert t0["zone"] == "short", t0["zone"]
    # Throughput expectations stay keyed on ABSOLUTE context.
    assert expected_rates(4000) == (1050, 78), expected_rates(4000)
    assert expected_rates(28029) == (715, 61), expected_rates(28029)
    assert expected_rates(200000) == (300, 35), expected_rates(200000)
    print("fullness zones scale to the window; speed bands stay absolute: ok")

    for themes, bgs, lim in ((THEMES, BACKGROUNDS, 256),
                             (THEMES_BASIC, BACKGROUNDS_BASIC, 8)):
        for th in themes:
            for bg_name, bg in bgs:
                c = compose(th, bg, lim)
                trio = {c["grn"], c["mag"], c["cyn"]}
                assert len(trio) == 3 and bg not in trio, (th["name"], bg_name)
                assert all(0 <= v < lim for v in c.values()
                           if isinstance(v, int) and v != -1), (th["name"], lim)
    print("themes: ctx/prefill/gen colors distinct on every background")

    # the sibling tool must carry a byte-identical grammar -----------------
    mine = _shared_block(os.path.realpath(__file__))
    sib_path = os.path.join(os.path.dirname(os.path.realpath(__file__)), SIBLING)
    theirs = _shared_block(sib_path)
    if mine is None:
        print("shared block: FAIL (not found in this file)")
        ok = False
    elif theirs is None:
        print("shared block: sibling %s not found — skipped" % SIBLING)
    elif mine != theirs:
        print("shared block: FAIL — %s has drifted out of sync" % SIBLING)
        ok = False
    else:
        print("shared block: identical in %s: ok" % SIBLING)

    print("graph rows:")
    for r in rows:
        print("  |%s|" % r)
    print("ALL PASS" if ok else "SOME FAILED")
    return 0 if ok else 1


def main(argv=None):
    ap = argparse.ArgumentParser(description="btop-style llama-server log dashboard")
    ap.add_argument("path", nargs="?", default=DEFAULT_LOG)
    ap.add_argument("--from-start", action="store_true",
                    help="seed graphs/stats from the whole file")
    ap.add_argument("--tail", type=int, default=4000, metavar="N",
                    help="seed from the last N lines (default 4000; 0 = none)")
    ap.add_argument("--ctx-max", type=int, default=DEFAULT_CTX_MAX,
                    help="fallback context window if it cannot be detected")
    ap.add_argument("--server", default=DEFAULT_SERVER, metavar="URL",
                    help="llama-server URL for /props (build, context window); "
                         "'' disables")
    ap.add_argument("--interval", type=float, default=0.2,
                    help="redraw cadence in seconds (default 0.2)")
    ap.add_argument("--no-color", action="store_true")
    ap.add_argument("--audit", action="store_true",
                    help="report parser coverage over the log, then exit")
    ap.add_argument("--self-test", action="store_true")
    args = ap.parse_args(argv)

    if args.self_test:
        return self_test()
    if args.audit:
        return audit_log(args.path)
    if not sys.stdout.isatty():
        sys.stderr.write("llama-top needs an interactive terminal "
                         "(use --self-test to validate logic headlessly).\n")
        return 2

    locale.setlocale(locale.LC_ALL, "")
    import curses
    try:
        curses.wrapper(run, args)
    except KeyboardInterrupt:
        pass
    return 0


if __name__ == "__main__":
    sys.exit(main())
