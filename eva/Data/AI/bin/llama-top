#!/usr/bin/env python3
"""
llama-top — a btop/htop-style live dashboard for llama-server logs.

Full-screen curses UI that tails llama-server.log and shows, refreshing in
place:
  • server status + llama-server build + model + context window + watch time
  • context-fill gauge and live prefill / generation meters
  • scrolling area graphs of prefill and generation throughput (t/s)
  • the current task on every busy slot (live prefill % / generation progress)
  • a table of the most recent completed turns
  • a session footer (totals, averages, prompt-cache hit rate)

This is standalone — it does NOT import llama-mon. The two tools do share one
verbatim block of log-grammar source (marked BEGIN/END shared log-grammar
block); --self-test checks that the sibling's copy has not drifted, because
"fixed one tool, forgot the other" is how the last format break survived.

Usage:
    llama-top                       # follow default log, seed graphs from history
    llama-top /path/to/llama.log
    llama-top --from-start          # seed graphs from the whole file
    llama-top --tail 8000           # seed from last 8000 lines (default 4000)
    llama-top --interval 0.1        # redraw cadence in seconds (default 0.2)
    llama-top --server http://host:8088   # where to query /props (build, ctx)
    llama-top --no-color
    llama-top --audit               # report parser coverage over the log
    llama-top --self-test           # exercise parser/graph logic without a TTY

Keys:  q / Esc quit   ·   c cycle color theme (C reverse)   ·   b cycle
       background (B reverse)   ·   x clear session stats   ·   p pause
"""
import argparse
import json
import locale
import os
import re
import sys
import threading
import time
from collections import deque

DEFAULT_LOG = "/Users/vasilis/Data/AI/Logs/llama-server.log"
DEFAULT_CTX_MAX = 262144          # fallback until /props or the log tells us
DEFAULT_SERVER = "http://127.0.0.1:8088"
# Meter full-scale. Measured peaks on this host are ~1230 t/s prefill and
# ~90 t/s generation; both meters also grow to fit anything faster observed,
# so a hardware or model change cannot peg them silently.
PP_FULL = 1200.0
TG_FULL = 90.0
MAX_SLOT_ROWS = 4                 # busy slots rendered in the Current task box
# A slot with no log activity for this long is treated as no longer busy. A
# turn that is cut off mid-flight (log rotated, server killed) never gets its
# release line, and without this the panel would show it as running forever.
STALE_SLOT_SECS = 180.0
# Prefill samples smaller than this are mostly fixed per-request overhead
# (measured: 4-32 token prefills average ~55 t/s against ~600 t/s for real
# prompts), so they are shown per turn but kept out of graphs and averages.
PP_STAT_MIN_TOK = 64
# Live slot state from GET /slots. The server answers between batches, so a
# reply can lag by one ubatch on a long prefill; samples older than
# LIVE_FRESH fall back to log-derived numbers.
SLOTS_POLL_SECS = 0.5
LIVE_FRESH = 12.0
LIVE_RATE_WINDOW = 3.0


# ----------------------------------------------------------------------------
# Parser + log grammar
# ----------------------------------------------------------------------------

# ==== BEGIN shared log-grammar block (kept byte-identical in llama-mon/llama-top)
#
# llama-server's log grammar drifted around build b10621. What changed:
#   "n_decoded = N, tg = X t/s"   -> "n_gen = N, tg = X t/s, tg_3s = Y t/s"
#   "sim_best = X"                -> "f_sim_best = X"
#   "server is listening on U"    -> "listening on U"
#   "new slot, n_ctx = N"         -> "initializing, n_slots = M, n_ctx_slot = N"
#   "system_info: n_threads ..."  -> "common_params_print_info: verbosity = N"
#   "all slots are idle"          -> gone; idleness is derived from slot state
#   "restored context checkpoint" -> gone; superseded by a server-wide prompt
#                                    cache that only announces itself on eviction
# New: "graphs reused", "making room for prompt cache entry", "stop: cancel
# task", per-request "got exception", MTP draft init, and multi-slot serving
# (n_slots > 1), which is why every per-request pattern now carries a slot id.
#
# Pre-b10621 shapes are all still matched so archived logs keep replaying.

_LINE = re.compile(r"^(\S+)\s+([IWE])\s+(.*)$")
# Nearly every per-request line is prefixed "id <slot> | task <id> |".
_SLOTID = re.compile(r"\bid\s+(\d+)\s*\|\s*task\s+(-?\d+)\b")

_PATTERNS = [
    # -- faults first: they contain words the lifecycle patterns also match --
    ("oom",          r"(Insufficient Memory \(.*?\)|kIOGPUCommandBufferCallbackErrorOutOfMemory)"),
    ("load_error",   r"(?:error loading model: |failed to load model[,:]?\s*)(.*)"),
    ("load_abort",   r"exiting due to model loading error"),
    ("slot_anomaly", r"(non-consecutive token position \d+ after \d+.*"
                     r"|removing memory module entries for seq_id.*)"),
    ("fit_error",    r"(failed to fit params to free device memory.*)"),
    ("decode_fail",  r"decode\(\) failed: (.*)"),
    ("spec_fail",    r"(failed to process speculative batch|llama_decode\(ctx_dft\).*)"),
    ("backend_err",  r"(ggml_metal_synchronize: error: .*"
                     r"|backend is in error state.*"
                     r"|failed to compute graph.*"
                     r"|llama_decode: failed to decode.*"
                     r"|ggml_backend_sched_graph_compute_async failed.*)"),
    ("req_error",    r"got exception: (.*)"),
    # -- process lifecycle ---------------------------------------------------
    ("boot",         r"(?:common_params_print_info: verbosity|system_info: n_threads)"),
    ("load_start",   r": loading model\b(?:\s*'([^']+)')?"),
    ("mmproj",       r"loaded multimodal model, '([^']+)'"),
    ("spec_draft",   r"creating MTP draft context against the target model '([^']+)'"),
    ("init_slots",   r"initializing, n_slots = (\d+), n_ctx_slot = (\d+)"),
    ("new_slot",     r"new slot,\s*n_ctx = (\d+)"),
    ("model_loaded", r": model loaded\b"),
    ("listening",    r"\blistening on (\S+)"),
    ("shutdown",     r"cleaning up before exit"),
    ("ctx_warn",     r"n_ctx_seq \((\d+)\) < n_ctx_train \((\d+)\)"),
    ("cors_warn",    r"CORS is set to allow all origins"),
    ("chat_format",  r"Chat format: (\S+)"),
    # -- scheduling / prompt cache -------------------------------------------
    ("pick_lcp",     r"selected slot by LCP similarity,\s*f?_?sim_best = ([\d.]+)"
                     r".*?f_keep = ([\d.]+)"),
    ("pick_lru",     r"selected slot by LRU"),
    ("launch",       r"launch_slot_:.*processing task"),
    ("cache_evict",  r"making room for prompt cache entry, removing oldest entry"
                     r" \(size = ([\d.]+) MiB\)"),
    ("cancel",       r"stop: cancel task, id_task = (\d+)"),
    ("restored",     r"restored context checkpoint \(pos_min = (\d+).*?"
                     r"n_tokens = (\d+).*?size = ([\d.]+) MiB\)"),
    ("checkpoint",   r"created context checkpoint (\d+) of (\d+) \(.*?"
                     r"n_tokens = (\d+), size = ([\d.]+) MiB\)"),
    ("reason_on",    r"reasoning-budget: activated"),
    ("reason_off",   r"reasoning-budget: deactivated"),
    # -- per-turn timings ----------------------------------------------------
    ("prefill_prog", r"prompt processing, n_tokens =\s*(\d+), progress = ([\d.]+),"
                     r" t =\s*([\d.]+) s / ([\d.]+) tokens per second"),
    ("gen_prog",     r"n_(?:gen|decoded) =\s*(\d+), tg =\s*([\d.]+) t/s"
                     r"(?:,\s*tg_3s =\s*([\d.]+) t/s)?"),
    ("pp_final",     r"\| prompt eval time =\s*([\d.]+) ms /\s*(\d+) tokens"
                     r" \(\s*([\d.]+) ms per token,\s*([\d.]+) tokens per second\)"),
    ("tg_final",     r"\|\s+eval time =\s*([\d.]+) ms /\s*(\d+) tokens"
                     r" \(\s*([\d.]+) ms per token,\s*([\d.]+) tokens per second\)"),
    ("total_time",   r"total time =\s*([\d.]+) ms /\s*(\d+) tokens"),
    ("graphs",       r"graphs reused =\s*(\d+)"),
    ("draft_acc",    r"draft acceptance = ([\d.]+) \(\s*(\d+) accepted /"
                     r"\s*(\d+) generated\)(?:, mean len =\s*([\d.]+))?"),
    ("release",      r"release:.*stop processing: n_tokens = (\d+), truncated = (\d+)"),
    ("idle",         r"update_slots: all slots are idle"),
]
_PATTERNS = [(kind, re.compile(rx)) for kind, rx in _PATTERNS]


def parse_line(text):
    """Classify one log line.

    Returns a dict(kind, lvl, slot, task, groups, raw), or None if the line is
    not a llama-server log line at all. Unrecognized log lines come back with
    kind "other" so callers can audit coverage instead of silently dropping
    them -- that silence is exactly how the b10621 drift went unnoticed.
    """
    m = _LINE.match(text)
    if not m:
        return None
    lvl, body = m.group(2), m.group(3)
    slot = task = None
    ms = _SLOTID.search(body)
    if ms:
        slot = int(ms.group(1))
        task = int(ms.group(2))
        if task < 0:            # "task -1" is the scheduler talking, not a turn
            task = None
    for kind, rx in _PATTERNS:
        g = rx.search(body)
        if g:
            return dict(kind=kind, lvl=lvl, slot=slot, task=task,
                        groups=g.groups(), raw=text)
    return dict(kind="other", lvl=lvl, slot=slot, task=task, groups=(), raw=text)


# Two different questions, deliberately kept apart.
#
# ZONES answers "how full is the context window" and is the label the UI prints
# next to the fullness gauge, so it MUST mean the same thing that gauge does.
# Keying it on an absolute token count instead makes it contradict the
# percentage sitting beside it: 27.9k of a 262k window is 11% full, which is
# not "long" by any reading a person would give it.
ZONES = [  # (label, upper bound as a fraction of the context window)
    ("short",     0.125),
    ("medium",    0.30),
    ("long",      0.50),
    ("very-long", 0.75),
    ("extreme",   None),
]


def ctx_zone(ctx, n_ctx):
    """Fullness band: how much of the serving window this turn occupies."""
    frac = (ctx / float(n_ctx)) if n_ctx else 0.0
    for label, hi in ZONES:
        if hi is None or frac < hi:
            return label
    return ZONES[-1][0]


# SPEED_BANDS answers "how fast should this turn have been", and is keyed on
# ABSOLUTE context instead, because attention cost tracks the KV size actually
# in play rather than what fraction of a configured window it happens to
# occupy: a 30k-token prompt costs the same whether the window is 64k or 262k.
# Measured over ~9k real turns on this host (llama-server b10621, 35B-A3B MoE
# + MTP draft, Metal).
SPEED_BANDS = [  # (ctx upper bound, expected prefill t/s, expected gen t/s)
    (8000,  1050, 78),
    (16000,  800, 66),
    (32000,  715, 61),
    (65536,  480, 48),
    (None,   300, 35),
]


def expected_rates(ctx):
    """Typical (prefill t/s, generation t/s) at a given absolute context."""
    for hi, pp, tg in SPEED_BANDS:
        if hi is None or ctx < hi:
            return pp, tg
    return SPEED_BANDS[-1][1], SPEED_BANDS[-1][2]


# llama-server emits degenerate timing lines for near-empty evals, e.g.
# "eval time = 0.00 ms / 1 tokens ( ... 1000000.00 tokens per second)".
# A sample must clear these floors/caps to count toward graphs and averages.
SANE_MIN_TOK = 4
SANE_MIN_MS = 50.0
PP_SANE_MAX = 50000.0
TG_SANE_MAX = 2000.0


def sane_sample(tok, ms, rate, cap):
    return bool(tok) and tok >= SANE_MIN_TOK and (ms or 0.0) >= SANE_MIN_MS \
        and rate is not None and rate <= cap


def read_tail_lines(path, n, upto=None, max_bytes=(32 << 20)):
    """Last n lines of a file, reading only the tail rather than the whole file.

    The default log is ~12 MB and grows; the old implementation did
    f.read().splitlines()[-n:], which paged all of it in on every start and on
    every rotation-triggered reopen.

    `upto` caps the read at a byte offset. Callers that then follow the file
    MUST pass the offset they will resume from, otherwise any line appended
    between this read and their seek is silently skipped.
    """
    if n <= 0:
        return []
    with open(path, "rb") as b:
        if upto is None:
            b.seek(0, os.SEEK_END)
            size = b.tell()
        else:
            size = upto
        pos, data, step = size, b"", (1 << 20)
        while pos > 0 and data.count(b"\n") <= n and (size - pos) < max_bytes:
            back = min(step, pos)
            pos -= back
            b.seek(pos)
            data = b.read(back) + data
    lines = data.decode("utf-8", "replace").splitlines()
    if pos > 0 and lines:
        lines = lines[1:]       # first line is probably a fragment
    return lines[-n:]


def audit_log(path, top=25, limit=None):
    """Report parser coverage over a real log, ranking unrecognized shapes.

    This is the drift alarm: the built-in self-test only proves the parser
    still handles lines someone thought to write down, which is why it stayed
    green through an upgrade that broke live parsing.
    """
    from collections import Counter
    num = re.compile(r"\d+")
    seen, unknown, examples = Counter(), Counter(), {}
    total = nolog = 0
    with open(path, "r", errors="replace") as f:
        for i, ln in enumerate(f):
            if limit and i >= limit:
                break
            ln = ln.rstrip("\n")
            if not ln.strip():
                continue
            total += 1
            ev = parse_line(ln)
            if ev is None:
                nolog += 1
                continue
            seen[ev["kind"]] += 1
            if ev["kind"] == "other":
                shape = num.sub("N", ev["raw"].split(" ", 1)[-1])[:110]
                unknown[shape] += 1
                examples.setdefault(shape, ev["raw"])
    known = total - nolog - seen["other"]
    print("log       : %s" % path)
    print("lines     : %d  (recognized %d = %.1f%%, unrecognized %d, non-log %d)"
          % (total, known, 100.0 * known / max(1, total), seen["other"], nolog))
    print("\nrecognized kinds:")
    for kind, c in seen.most_common():
        if kind != "other":
            print("  %-14s %7d" % (kind, c))
    missing = [k for k, _ in _PATTERNS if not seen.get(k)]
    if missing:
        print("\nnever seen in this log (may be fine, may be drift):")
        print("  " + ", ".join(sorted(set(missing))))
    if unknown:
        print("\ntop unrecognized shapes:")
        for shape, c in unknown.most_common(top):
            print("  %7d  %s" % (c, shape))
    return 0
# ==== END shared log-grammar block


# ----------------------------------------------------------------------------
# Small helpers
# ----------------------------------------------------------------------------

def human_k(n):
    n = float(n or 0)
    if abs(n) >= 1e9:
        return "%.1fG" % (n / 1e9)
    if abs(n) >= 1e6:
        return "%.1fM" % (n / 1e6)
    if abs(n) >= 1000:
        return "%.1fk" % (n / 1000.0)
    return "%d" % n


def server_props(url, timeout=1.5):
    """Best-effort GET /props from a running llama-server.
    Returns dict(version, n_ctx, model, slots) or None if unreachable."""
    import urllib.request
    try:
        with urllib.request.urlopen(url.rstrip("/") + "/props", timeout=timeout) as r:
            d = json.load(r)
    except Exception:
        return None
    model = os.path.basename(d.get("model_path") or d.get("model_alias") or "")
    model = re.sub(r"\.gguf$", "", model)
    return dict(version=d.get("build_info"),
                n_ctx=(d.get("default_generation_settings") or {}).get("n_ctx"),
                model=model or None,
                slots=d.get("total_slots"))


